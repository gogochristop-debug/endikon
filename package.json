{
  "name": "endikon",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "build:cloudflare": "opennextjs-cloudflare build",
    "preview:cloudflare": "opennextjs-cloudflare preview",
    "deploy:cloudflare": "opennextjs-cloudflare deploy",
    "check:cloudflare": "wrangler deploy --dry-run",
    "typegen:cloudflare": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "smoke:cloudflare": "SMOKE_BASE_URL=http://localhost:8787 node scripts/smoke.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "next": "16.3.8",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.10",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.0",
    "wrangler": "4.149.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
